{
  "buildCommand": "npm run build",
  "outputDirectory": "vercel-static",
  "git": {
    "deploymentEnabled": true
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/pwa-sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/pilehead",
      "destination": "/play",
      "permanent": true
    },
    {
      "source": "/pilehead/index.html",
      "destination": "/play",
      "permanent": true
    },
    {
      "source": "/stack",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pilehead/gallery.html",
      "destination": "/deck",
      "permanent": true
    },
    {
      "source": "/pilehead/gallery",
      "destination": "/deck",
      "permanent": true
    }
  ],
  "regions": [
    "fra1"
  ]
}
