{
  "name": "spark-card-game",
  "version": "0.8.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node scripts/test.mjs",
    "build": "node scripts/build-integrated.mjs",
    "build:vercel": "node scripts/build-integrated.mjs",
    "build:integrated": "node scripts/build-integrated.mjs",
    "test:integrated": "node tests/stack-single-service.cjs",
    "simulate": "node scripts/simulate.mjs",
    "test:pilehead": "node scripts/test.mjs",
    "test:pilehead-online": "node tests/pilehead-online.cjs",
    "test:pilehead-ui": "node tests/pilehead-firstperson.cjs && node tests/pilehead-production-ui.cjs && node tests/pilehead-physics.cjs",
    "test:pilehead-art": "node tests/pilehead-deck-art.cjs && node tests/pilehead-raster-assets.cjs && node tests/pilehead-stack-brand.cjs",
    "test:pilehead-groups": "node tests/pilehead-matching-actions.cjs",
    "test:pilehead-hand": "node tests/pilehead-hand-ui.cjs && node tests/pilehead-actions-ux.cjs",
    "test:pilehead-finale": "node tests/pilehead-finale.cjs",
    "test:pilehead-playtest": "node tests/pilehead-playtest.cjs",
    "bench:endgame-lab": "node scripts/bench-endgame-lab.cjs",
    "test:endgame-lab-browser": "node tests/stack-endgame-lab-browser.cjs",
    "build:shared-assets": "node scripts/build-vercel.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "1.2.0",
    "ws": "8.23.0"
  },
  "description": "STACK physical-first card game and online multiplayer"
}
